    "@strands-agents/sdk": "1.3.0",
    "aws-cdk-lib": "2.230.0",
    "constructs": "10.4.2",
    "standardwebhooks": "1.0.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "22.10.10",
    "eslint": "^9.18.0",
    "fast-check": "3.23.2",
    "globals": "^15.14.0",
