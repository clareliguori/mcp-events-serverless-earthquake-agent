{
  "name": "mcp-events-serverless-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "MCP Events Serverless Agent — earthquake monitoring sample (multi-package monorepo)",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/shared",
    "packages/mcp-server-core",
    "packages/cdk",
    "packages/data-api",
    "packages/usgs-server",
    "packages/scheduler-server",
    "packages/webhook-receiver",
    "packages/agent",
    "packages/subscription-manager",
    "packages/webapp",
